  "screens": [
    {
      "id": "preferences",
      "name": "饮食偏好",
      "root": {
        "id": "preferences.root",
        "component": "Screen",
        "style": {
          "backgroundColor": "$color.canvas",
          "color": "$color.text.primary"
        },
        "children": [
          {
            "id": "preferences.header",
            "component": "Frame",
            "layout": {
              "direction": "row",
              "width": "fill",
              "height": 52,
              "align": "center",
              "justify": "center"
            },
            "style": {
              "backgroundColor": "$color.canvas",
              "borderBottomColor": "$color.border.subtle",
              "borderBottomWidth": 1
            },
            "children": [
              {
                "id": "preferences.header.back",
                "component": "Button",
                "stable_id": "preferences.header.back",
                "layout": {
                  "direction": "row",
                  "width": "hug",
                  "height": 44,
                  "align": "center",
                  "position": "absolute",
                  "inset": {
                    "top": 4,
                    "left": 20
                  }
                },
                "style": {
                  "color": "$color.brand.strong",
                  "typography": "$type.back"
                },
                "props": {
                  "label": "‹ 返回"
                }
              },
              {
                "id": "preferences.header.title",
                "component": "Text",
                "stable_id": "preferences.header.title",
                "style": {
                  "color": "$color.text.primary",
                  "typography": "$type.header",
                  "textAlign": "center"
                },
                "props": {
                  "text": "饮食偏好"
                }
              }
            ]
          },
          {
            "id": "preferences.content",
            "component": "Frame",
            "layout": {
              "direction": "column",
              "width": "fill",
              "padding": [
                22,
                "$dimension.screen.padding",
                20,
                "$dimension.screen.padding"
              ],
              "gap": 25,
              "flex": 1,
              "overflow": "hidden"
            },
            "children": [
              {
                "id": "preferences.spice",
                "component": "ChoiceGroup",
                "layout": {
                  "columns": 4,
                  "gap": 8
                },
                "slot_styles": {
                  "title": {
                    "color": "$color.text.primary",
                    "typography": "$type.section"
                  },
                  "note": {
                    "color": "$color.text.secondary",
                    "typography": "$type.note"
                  },
                  "option": {
                    "borderColor": "$color.border",
                    "borderRadius": "$radius.control",
                    "borderWidth": 1,
                    "color": "$color.text.primary",
                    "minHeight": "$dimension.control.height",
                    "typography": "$type.option",
                    "backgroundColor": "$color.canvas"
                  },
                  "option_selected": {
                    "backgroundColor": "$color.selection",
                    "borderColor": "$color.brand.strong",
                    "borderWidth": 2,
                    "color": "$color.brand.strong"
                  }
                },
                "props": {
                  "title": "辣度",
                  "note": "单选",
                  "mode": "single",
                  "options_source": "spice_options",
                  "selected_path": "values.spice",
                  "stable_id_prefix": "preferences.spice",
                  "header_gap": 11
                }
              },
              {
                "id": "preferences.budget",
                "component": "ChoiceGroup",
                "layout": {
                  "columns": 2,
                  "gap": 10
                },
                "slot_styles": {
                  "title": {
                    "color": "$color.text.primary",
                    "typography": "$type.section"
                  },
                  "note": {
                    "color": "$color.text.secondary",
                    "typography": "$type.note"
                  },
                  "option": {
                    "borderColor": "$color.border",
                    "borderRadius": "$radius.control",
                    "borderWidth": 1,
                    "color": "$color.text.primary",
                    "minHeight": "$dimension.control.height",
                    "typography": "$type.option",
                    "backgroundColor": "$color.canvas"
                  },
                  "option_selected": {
                    "backgroundColor": "$color.selection",
                    "borderColor": "$color.brand.strong",
                    "borderWidth": 2,
                    "color": "$color.brand.strong"
                  }
                },
                "props": {
                  "title": "单餐预算",
                  "note": "单选",
                  "mode": "single",
                  "options_source": "budget_options",
                  "selected_path": "values.budget",
                  "stable_id_prefix": "preferences.budget",
                  "header_gap": 11
                }
              },
              {
                "id": "preferences.avoid",
                "component": "ChoiceGroup",
                "layout": {
                  "columns": 4,
                  "gap": 9
                },
                "slot_styles": {
                  "title": {
                    "color": "$color.text.primary",
                    "typography": "$type.section"
                  },
                  "note": {
                    "color": "$color.text.secondary",
                    "typography": "$type.note"
                  },
                  "option": {
                    "borderColor": "$color.border",
                    "borderRadius": "$radius.control",
                    "borderWidth": 1,
                    "color": "$color.text.primary",
                    "minHeight": "$dimension.control.height",
                    "typography": "$type.option",
                    "backgroundColor": "$color.canvas"
                  },
                  "option_selected": {
                    "backgroundColor": "$color.selection",
                    "borderColor": "$color.brand.strong",
                    "borderWidth": 2,
                    "color": "$color.brand.strong"
                  }
                },
                "props": {
                  "title": "忌口",
                  "note": "可多选",
                  "mode": "multiple",
                  "options_source": "avoid_options",
                  "selected_path": "values.avoid",
                  "stable_id_prefix": "preferences.avoid",
                  "header_gap": 11
                }
              },
              {
                "id": "preferences.summary.card",
                "component": "Frame",
                "layout": {
                  "direction": "column",
                  "width": "fill",
                  "height": 64,
                  "padding": [
                    10,
                    14,
                    10,
                    14
                  ],
                  "gap": 7
                },
                "style": {
                  "backgroundColor": "$color.selection",
                  "borderRadius": "$radius.card"
                },
                "children": [
                  {
                    "id": "preferences.summary.label",
                    "component": "Text",
                    "stable_id": "preferences.summary.label",
                    "style": {
                      "color": "$color.text.secondary",
                      "typography": "$type.summary.label"
                    },
                    "props": {
                      "text": "当前偏好"
                    }
                  },
                  {
                    "id": "preferences.summary",
                    "component": "Text",
                    "stable_id": "preferences.summary",
                    "style": {
                      "color": "$color.text.primary",
                      "typography": "$type.summary.value"
                    },
                    "props": {
                      "text_path": "view.summary"
                    }
                  },
                  {
                    "id": "preferences.summary.decor",
                    "component": "Decoration",
                    "layout": {
                      "width": 32,
                      "height": 6,
                      "position": "absolute",
                      "inset": {
                        "right": 12,
                        "bottom": 10
                      }
                    },
                    "style": {
                      "backgroundColor": "$color.brand.action",
                      "borderRadius": 3
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "preferences.actions",
            "component": "Frame",
            "layout": {
              "direction": "row",
              "width": "fill",
              "height": 96,
              "padding": [
                12,
                "$dimension.screen.padding",
                34,
                "$dimension.screen.padding"
              ],
              "gap": 12
            },
            "style": {
              "backgroundColor": "$color.canvas",
              "borderTopColor": "$color.border.subtle",
              "borderTopWidth": 1
            },
            "children": [
              {
                "id": "preferences.actions.reset",
                "component": "Button",
                "stable_id": "preferences.actions.reset",
                "layout": {
                  "width": 132,
                  "height": "$dimension.action.height"
                },
                "style": {
                  "borderColor": "$color.border",
                  "borderRadius": "$radius.card",
                  "borderWidth": 1,
                  "color": "$color.text.secondary",
                  "typography": "$type.action",
                  "backgroundColor": "$color.canvas"
                },
                "props": {
                  "label": "恢复默认"
                }
              },
              {
                "id": "preferences.actions.save",
                "component": "Button",
                "stable_id": "preferences.actions.save",
                "layout": {
                  "width": "fill",
                  "height": "$dimension.action.height",
                  "flex": 1
                },
                "style": {
                  "backgroundColor": "$color.brand.action",
                  "borderRadius": "$radius.card",
                  "color": "$color.on.brand",
                  "typography": "$type.action"
                },
                "props": {
                  "label": "保存偏好"
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "interactions": [
