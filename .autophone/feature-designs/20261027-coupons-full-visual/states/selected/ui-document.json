  "screens": [
    {
      "id": "coupons",
      "name": "优惠券选择与金额明细",
      "root": {
        "id": "coupons.root",
        "component": "Screen",
        "style": {
          "backgroundColor": "$color.canvas",
          "color": "$color.text"
        },
        "children": [
          {
            "id": "coupons.header",
            "component": "Frame",
            "layout": {
              "direction": "row",
              "width": "fill",
              "gap": "$space.small",
              "height": "$space.header",
              "align": "center",
              "justify": "between",
              "padding": [
                0,
                "$space.page",
                0,
                "$space.page"
              ]
            },
            "children": [
              {
                "id": "coupons.back",
                "component": "Button",
                "stable_id": "coupons.back",
                "layout": {
                  "width": 64,
                  "height": "$space.control"
                },
                "style": {
                  "typography": "$type.label",
                  "color": "$color.brand",
                  "backgroundColor": "$color.surface",
                  "borderRadius": "$space.radius"
                },
                "props": {
                  "label_path": "view.back"
                }
              },
              {
                "id": "coupons.brand",
                "component": "Text",
                "stable_id": "coupons.brand",
                "style": {
                  "typography": "$type.label",
                  "color": "$color.brand"
                },
                "props": {
                  "text_path": "view.brand"
                }
              }
            ]
          },
          {
            "id": "coupons.content",
            "component": "Frame",
            "layout": {
              "direction": "column",
              "width": "fill",
              "gap": "$space.gap",
              "flex": 1,
              "padding": [
                "$space.small",
                "$space.page",
                "$space.gap",
                "$space.page"
              ],
              "overflow": "auto"
            },
            "children": [
              {
                "id": "coupons.title",
                "component": "Text",
                "stable_id": "coupons.title",
                "style": {
                  "typography": "$type.title",
                  "color": "$color.text"
                },
                "props": {
                  "text_path": "view.title"
                }
              },
              {
                "id": "coupons.description",
                "component": "Text",
                "stable_id": "coupons.description",
                "style": {
                  "typography": "$type.body",
                  "color": "$color.muted"
                },
                "props": {
                  "text_path": "view.description"
                }
              },
              {
                "id": "coupons.option",
                "component": "ChoiceGroup",
                "layout": {
                  "width": "fill",
                  "columns": 1,
                  "gap": "$space.small"
                },
                "props": {
                  "title": "可用优惠券",
                  "mode": "single",
                  "options_source": "option",
                  "selected_path": "values.option",
                  "stable_id_prefix": "coupons.option",
                  "header_gap": 12
                },
                "slot_styles": {
                  "title": {
                    "typography": "$type.heading",
                    "color": "$color.text"
                  },
                  "option": {
                    "minHeight": "$space.option",
                    "typography": "$type.label",
                    "backgroundColor": "$color.surface",
                    "color": "$color.muted",
                    "borderColor": "$color.border",
                    "borderWidth": 1,
                    "borderRadius": 12
                  },
                  "option_selected": {
                    "color": "$color.brand",
                    "backgroundColor": "$color.soft",
                    "borderColor": "$color.brand"
                  }
                }
              },
              {
                "id": "coupons.unavailable",
                "component": "Frame",
                "layout": {
                  "direction": "column",
                  "width": "fill",
                  "gap": "$space.small",
                  "padding": [
                    "$space.gap",
                    "$space.gap",
                    "$space.gap",
                    "$space.gap"
                  ]
                },
                "children": [
                  {
                    "id": "coupons.unavailable.save20.title",
                    "component": "Text",
                    "stable_id": "coupons.unavailable.save20.title",
                    "style": {
