                    "style": {
                      "typography": "$type.label",
                      "color": "$color.text"
                    },
                    "props": {
                      "text_path": "view.payable_label"
                    }
                  },
                  {
                    "id": "coupons.payable",
                    "component": "Text",
                    "stable_id": "coupons.payable",
                    "style": {
                      "typography": "$type.price",
                      "color": "$color.brand"
                    },
                    "props": {
                      "text_path": "view.payable"
                    }
                  }
                ]
              },
              {
                "id": "coupons.confirm",
                "component": "Button",
                "stable_id": "coupons.confirm",
                "layout": {
                  "width": "fill",
                  "height": "$space.control"
                },
                "style": {
                  "typography": "$type.label",
                  "color": "$color.surface",
                  "backgroundColor": "$color.brand",
                  "borderRadius": "$space.radius"
                },
                "props": {
                  "label_path": "view.confirm"
                }
              }
            ],
            "style": {
              "backgroundColor": "$color.surface",
              "borderTopColor": "$color.border",
              "borderTopWidth": 1
            }
          }
        ]
      }
