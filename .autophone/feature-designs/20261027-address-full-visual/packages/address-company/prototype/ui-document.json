{
  "schema_version": "ui-prototype-document/v1",
  "name": "配送地址选择 · company",
  "tokens": {
    "color.canvas": {
      "type": "color",
      "value": "#FFF8EF"
    },
    "color.surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.text": {
      "type": "color",
      "value": "#241713"
    },
    "color.muted": {
      "type": "color",
      "value": "#77655F"
    },
    "color.brand": {
      "type": "color",
      "value": "#E6472F"
    },
    "color.soft": {
      "type": "color",
      "value": "#F7D7B5"
    },
    "color.border": {
      "type": "color",
      "value": "#E8DCD3"
    },
    "color.success": {
      "type": "color",
      "value": "#2D7046"
    },
    "color.successSoft": {
      "type": "color",
      "value": "#E8F3EA"
    },
    "space.page": {
      "type": "dimension",
      "value": 22
    },
    "space.gap": {
      "type": "dimension",
      "value": 16
    },
    "space.small": {
      "type": "dimension",
      "value": 8
    },
    "space.radius": {
      "type": "dimension",
      "value": 16
    },
    "space.control": {
      "type": "dimension",
      "value": 48
    },
    "space.option": {
      "type": "dimension",
      "value": 52
    },
    "space.header": {
      "type": "dimension",
      "value": 64
    },
    "type.title": {
      "type": "typography",
      "value": {
        "fontSize": 26,
        "fontWeight": 700,
        "lineHeight": 36
      }
    },
    "type.heading": {
      "type": "typography",
      "value": {
        "fontSize": 18,
        "fontWeight": 600,
        "lineHeight": 26
      }
    },
    "type.body": {
      "type": "typography",
      "value": {
        "fontSize": 15,
        "fontWeight": 400,
        "lineHeight": 23
      }
    },
    "type.label": {
      "type": "typography",
      "value": {
        "fontSize": 15,
        "fontWeight": 600,
        "lineHeight": 22
      }
    },
    "type.caption": {
      "type": "typography",
      "value": {
        "fontSize": 13,
        "fontWeight": 400,
        "lineHeight": 20
      }
    },
    "type.price": {
      "type": "typography",
      "value": {
        "fontSize": 28,
        "fontWeight": 700,
        "lineHeight": 38
      }
    }
  },
  "screens": [
    {
      "id": "address",
      "name": "配送地址选择",
      "root": {
        "id": "address.root",
        "component": "Screen",
        "style": {
          "backgroundColor": "$color.canvas",
          "color": "$color.text"
        },
        "children": [
          {
            "id": "address.header",
            "component": "Frame",
            "layout": {
              "direction": "row",
              "width": "fill",
              "gap": "$space.small",
              "height": "$space.header",
              "align": "center",
              "justify": "between",
              "padding": [
                0,
                "$space.page",
                0,
                "$space.page"
              ]
            },
            "children": [
              {
                "id": "address.back",
                "component": "Button",
                "stable_id": "address.back",
                "layout": {
                  "width": 64,
                  "height": "$space.control"
                },
                "style": {
                  "typography": "$type.label",
                  "color": "$color.brand",
                  "backgroundColor": "$color.surface",
                  "borderRadius": "$space.radius"
                },
                "props": {
                  "label_path": "view.back"
                }
              },
              {
                "id": "address.brand",
                "component": "Text",
                "stable_id": "address.brand",
                "style": {
                  "typography": "$type.label",
                  "color": "$color.brand"
                },
                "props": {
                  "text_path": "view.brand"
                }
              }
            ]
          },
          {
            "id": "address.content",
            "component": "Frame",
            "layout": {
              "direction": "column",
              "width": "fill",
              "gap": "$space.gap",
              "flex": 1,
              "padding": [
                "$space.small",
                "$space.page",
                "$space.gap",
                "$space.page"
              ],
              "overflow": "auto"
            },
            "children": [
              {
                "id": "address.title",
                "component": "Text",
                "stable_id": "address.title",
                "style": {
                  "typography": "$type.title",
                  "color": "$color.text"
                },
                "props": {
                  "text_path": "view.title"
                }
              },
              {
                "id": "address.description",
                "component": "Text",
                "stable_id": "address.description",
                "style": {
                  "typography": "$type.body",
                  "color": "$color.muted"
                },
                "props": {
                  "text_path": "view.description"
                }
              },
              {
                "id": "address.option",
                "component": "ChoiceGroup",
                "layout": {
                  "width": "fill",
                  "columns": 1,
                  "gap": "$space.small"
                },
                "props": {
                  "title": "常用地址",
                  "mode": "single",
                  "options_source": "option",
                  "selected_path": "values.option",
                  "stable_id_prefix": "address.option",
                  "header_gap": 12
                },
                "slot_styles": {
                  "title": {
                    "typography": "$type.heading",
                    "color": "$color.text"
                  },
                  "option": {
                    "minHeight": "$space.option",
                    "typography": "$type.label",
                    "backgroundColor": "$color.surface",
                    "color": "$color.muted",
                    "borderColor": "$color.border",
                    "borderWidth": 1,
                    "borderRadius": 12
                  },
                  "option_selected": {
                    "color": "$color.brand",
                    "backgroundColor": "$color.soft",
                    "borderColor": "$color.brand"
                  }
                }
              },
              {
                "id": "address.detail",
                "component": "Frame",
                "layout": {
                  "direction": "column",
                  "width": "fill",
                  "gap": "$space.small",
                  "padding": [
                    "$space.gap",
                    "$space.gap",
                    "$space.gap",
                    "$space.gap"
                  ]
                },
                "children": [
                  {
                    "id": "address.detail.tag",
                    "component": "Text",
                    "stable_id": "address.detail.tag",
                    "style": {
                      "typography": "$type.caption",
                      "color": "$color.brand"
                    },
                    "props": {
                      "text_path": "view.detail_tag"
                    }
                  },
                  {
                    "id": "address.detail.address",
                    "component": "Text",
                    "stable_id": "address.detail.address",
                    "style": {
                      "typography": "$type.heading",
                      "color": "$color.text"
                    },
                    "props": {
                      "text_path": "view.detail_address"
                    }
                  },
                  {
                    "id": "address.detail.room",
                    "component": "Text",
                    "stable_id": "address.detail.room",
                    "style": {
                      "typography": "$type.body",
                      "color": "$color.text"
                    },
                    "props": {
                      "text_path": "view.detail_room"
                    }
                  },
                  {
                    "id": "address.detail.contact",
                    "component": "Text",
                    "stable_id": "address.detail.contact",
                    "style": {
                      "typography": "$type.caption",
                      "color": "$color.muted"
                    },
                    "props": {
                      "text_path": "view.detail_contact"
                    }
                  }
                ],
                "style": {
                  "backgroundColor": "$color.surface",
                  "borderRadius": "$space.radius"
                }
              },
              {
                "id": "address.notice",
                "component": "Text",
                "stable_id": "address.notice",
                "style": {
                  "typography": "$type.caption",
                  "color": "$color.muted"
                },
                "props": {
                  "text_path": "view.notice"
                }
              }
            ]
          },
          {
            "id": "address.footer",
            "component": "Frame",
            "layout": {
              "direction": "column",
              "width": "fill",
              "gap": "$space.small",
              "padding": [
                "$space.gap",
                "$space.page",
                "$space.gap",
                "$space.page"
              ]
            },
            "children": [
              {
                "id": "address.summary",
                "component": "Text",
                "stable_id": "address.summary",
                "style": {
                  "typography": "$type.label",
                  "color": "$color.text"
                },
                "props": {
                  "text_path": "view.summary"
                }
              },
              {
                "id": "address.confirm",
                "component": "Button",
                "stable_id": "address.confirm",
                "layout": {
                  "width": "fill",
                  "height": "$space.control"
                },
                "style": {
                  "typography": "$type.label",
                  "color": "$color.surface",
                  "backgroundColor": "$color.brand",
                  "borderRadius": "$space.radius"
                },
                "props": {
                  "label_path": "view.confirm"
                }
              }
            ],
            "style": {
              "backgroundColor": "$color.surface",
              "borderTopColor": "$color.border",
              "borderTopWidth": 1
            }
          }
        ]
      }
    }
  ],
  "interactions": [
    {
      "id": "address.option.home.change",
      "trigger": {
        "type": "press",
        "target_stable_id": "address.option.home"
      },
      "action": {
        "type": "set_value",
        "path": "values.option"
      }
    },
    {
      "id": "address.option.company.change",
      "trigger": {
        "type": "press",
        "target_stable_id": "address.option.company"
      },
      "action": {
        "type": "set_value",
        "path": "values.option"
      }
    },
    {
      "id": "address.confirm.press",
      "trigger": {
        "type": "press",
        "target_stable_id": "address.confirm"
      },
      "action": {
        "type": "save"
      }
    }
  ],
  "prototype": {
    "start_screen_id": "address"
  },
  "acceptance": [
    {
      "screen_id": "address",
      "targets": [
        {
          "stable_id": "address.description",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.option.home",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.backgroundColor",
            "resolved_style.borderRadius",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.option.company",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.backgroundColor",
            "resolved_style.borderRadius",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.detail.tag",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.detail.address",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.detail.room",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.detail.contact",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.notice",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.summary",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.confirm",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.backgroundColor",
            "resolved_style.borderRadius",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.back",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.backgroundColor",
            "resolved_style.borderRadius",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.brand",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        },
        {
          "stable_id": "address.title",
          "properties": [
            "text",
            "resolved_style.color",
            "resolved_style.fontSize",
            "frame.x",
            "frame.y",
            "frame.width",
            "frame.height"
          ]
        }
      ]
    }
  ]
}
