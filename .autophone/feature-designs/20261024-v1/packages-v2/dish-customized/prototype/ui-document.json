        "component": "Screen",
        "style": {
          "backgroundColor": "$color.canvas",
          "color": "$color.text"
        },
        "children": [
          {
            "id": "dish.header",
            "component": "Frame",
            "layout": {
              "direction": "row",
              "width": "fill",
              "gap": "$space.small",
              "height": "$space.header",
              "align": "center",
              "justify": "between",
              "padding": [
                0,
                "$space.page",
                0,
                "$space.page"
              ]
            },
            "children": [
              {
                "id": "dish.back",
                "component": "Button",
                "stable_id": "dish.back",
                "layout": {
                  "width": 64,
                  "height": "$space.control"
                },
                "style": {
                  "typography": "$type.label",
                  "color": "$color.brand",
                  "backgroundColor": "$color.surface",
                  "borderRadius": "$space.radius"
                },
                "props": {
                  "label_path": "view.back"
                }
              },
              {
                "id": "dish.brand",
                "component": "Text",
                "stable_id": "dish.brand",
                "style": {
