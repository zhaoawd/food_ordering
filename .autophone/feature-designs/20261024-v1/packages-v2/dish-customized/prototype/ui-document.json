                "props": {
                  "title": "份量",
                  "mode": "single",
                  "options_source": "portion",
                  "selected_path": "values.portion",
                  "stable_id_prefix": "dish.portion",
                  "header_gap": 12
                },
                "slot_styles": {
                  "title": {
                    "typography": "$type.heading",
                    "color": "$color.text"
                  },
                  "option": {
                    "minHeight": "$space.option",
                    "typography": "$type.label",
                    "backgroundColor": "$color.surface",
                    "color": "$color.muted",
                    "borderColor": "$color.border",
                    "borderWidth": 1,
                    "borderRadius": 12
                  },
                  "option_selected": {
                    "color": "$color.brand",
                    "backgroundColor": "$color.soft",
                    "borderColor": "$color.brand"
                  }
