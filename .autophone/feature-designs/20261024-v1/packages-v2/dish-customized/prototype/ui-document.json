                "id": "dish.title",
                "component": "Text",
                "stable_id": "dish.title",
                "style": {
                  "typography": "$type.title",
                  "color": "$color.text"
                },
                "props": {
                  "text_path": "view.title"
                }
              },
              {
                "id": "dish.dish.card",
                "component": "Frame",
                "layout": {
                  "direction": "column",
                  "width": "fill",
                  "gap": "$space.small",
                  "padding": [
                    "$space.gap",
                    "$space.gap",
                    "$space.gap",
                    "$space.gap"
                  ]
