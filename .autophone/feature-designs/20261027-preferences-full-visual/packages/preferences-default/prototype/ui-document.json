                "props": {
                  "title": "辣度",
                  "mode": "single",
                  "options_source": "spice",
                  "selected_path": "values.spice",
                  "stable_id_prefix": "preferences.spice",
                  "header_gap": 12
                },
                "slot_styles": {
                  "title": {
                    "typography": "$type.heading",
                    "color": "$color.text"
