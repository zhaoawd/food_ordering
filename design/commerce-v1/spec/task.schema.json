{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentTask",
  "type": "object",
  "required": [
    "id",
    "title",
    "depends_on",
    "feature_ids",
    "allowed_paths",
    "acceptance_test_ids",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^A[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "feature_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^F[0-9]{2}$"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance_test_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{3}$"
      }
    },
    "status": {
      "const": "ready_for_planning_not_implemented"
    }
  },
  "additionalProperties": true
}
