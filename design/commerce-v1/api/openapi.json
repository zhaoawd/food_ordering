    "/payments/{paymentId}": {
      "get": {
        "operationId": "reconcilePayment",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Read/reconcile the same intent; unknown is not failure. Provider callbacks are private, signed, server-only and outside this mobile contract.",
        "responses": {
          "200": {
            "description": "Payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "401": {
            "description": "Typed error; no partial success",
