  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Store": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "closed",
              "paused"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "channels": {
            "type": "array",
            "items": {
              "enum": [
                "pickup",
                "dine_in",
                "delivery"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "timezone",
          "channels"
        ],
        "additionalProperties": false
      },
      "CartLine": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "required": [
          "product_id",
          "options",
          "quantity"
        ],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          },
          "option_group_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "price_cents",
          "available",
          "option_group_ids"
        ],
        "additionalProperties": false
      },
      "Menu": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string"
          },
          "store_id": {
            "type": "string"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        },
        "required": [
          "revision",
          "store_id",
          "products"
        ],
        "additionalProperties": false
      },
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "store_id": {
            "type": "string"
          },
          "channel": {
            "enum": [
              "pickup",
              "dine_in",
              "delivery"
            ]
          },
          "menu_revision": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/CartLine"
            }
          },
          "coupon_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "address_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "slot_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "store_id",
          "channel",
          "menu_revision",
          "lines",
          "coupon_id"
        ],
        "additionalProperties": false
      },
      "Quote": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "store_id",
          "channel",
          "cart_digest",
          "price_revision",
          "expires_at",
          "currency",
          "goods_cents",
          "packaging_cents",
          "delivery_cents",
          "discount_cents",
          "payable_cents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "user_id": {
            "type": "string",
            "minLength": 1
          },
          "store_id": {
            "type": "string",
            "minLength": 1
          },
          "cart_digest": {
            "type": "string",
            "minLength": 1
          },
          "price_revision": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "enum": [
              "pickup",
              "dine_in",
              "delivery"
            ]
          },
          "currency": {
            "const": "CNY"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "goods_cents": {
            "type": "integer",
            "minimum": 0
          },
          "packaging_cents": {
            "type": "integer",
            "minimum": 0
          },
          "delivery_cents": {
            "type": "integer",
            "minimum": 0
          },
          "discount_cents": {
            "type": "integer",
            "minimum": 0
          },
          "payable_cents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string"
          },
          "cart_digest": {
            "type": "string"
          },
          "store_confirmed": {
            "const": true
          },
          "note": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "quote_id",
          "cart_digest",
          "store_confirmed"
        ],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "awaiting_payment",
              "confirmed",
              "preparing",
              "ready_for_pickup",
              "out_for_delivery",
              "completed",
              "canceled",
              "expired"
            ]
          },
          "payment_status": {
            "enum": [
              "created",
              "pending",
              "unknown",
              "succeeded",
              "failed"
            ]
          },
          "refund_status": {
            "enum": [
              "none",
              "requested",
              "approved",
              "processing",
              "succeeded",
              "rejected",
              "failed"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "$ref": "#/components/schemas/Quote"
          },
          "pickup_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "payment_status",
          "refund_status",
          "revision",
          "quote",
          "pickup_code"
        ],
        "additionalProperties": false
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false
      },
      "PaymentRequest": {
        "type": "object",
        "properties": {
          "provider": {
            "enum": [
              "mock",
              "production_provider_adapter"
            ]
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "created",
              "pending",
              "unknown",
              "succeeded",
              "failed"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "const": "CNY"
          }
        },
        "required": [
          "id",
          "order_id",
          "status",
          "amount_cents",
          "currency"
        ],
        "additionalProperties": false
      },
      "CancelRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "enum": [
              "customer_changed_mind",
              "wrong_store",
              "other"
            ]
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "RefundRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "enum": [
              "missing_item",
              "quality_issue",
              "canceled_order_late_payment",
              "other"
            ]
          },
          "order_line_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "requested",
              "approved",
              "processing",
              "succeeded",
              "rejected",
              "failed"
            ]
          },
          "approved_amount_cents": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "order_id",
          "status",
          "approved_amount_cents"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
