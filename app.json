{
  "expo": {
    "name": "Food AI Verification",
    "slug": "fast_food",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fastfood",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.autophone.foodorderingdemo.v2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./verification/withAutophoneFmtCompatibility"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "jsc",
    "extra": {
      "autophoneVerification": {
        "profileId": "food-ordering-v2-ios-vm-fixture-v5-full-visual",
        "stateId": "home.default.fixture-v1",
        "locale": "en-US"
      }
    }
  }
}
